<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.beatronik.djstudio" />
        <package android:name="com.beatronik.djstudiodemo" />
        <package android:name="com.beatronik.discdj" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <service
            android:name=".DiscDJAccessibilityService"
            android:label="MixOrder DiscDJ Robot"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/discdj_accessibility_service" />
        </service>

        <service
            android:name=".DiscDJRobotService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".DiscDJRobotReceiver"
            android:exported="false" />
    </application>
</manifest>
